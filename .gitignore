# BDS Manager Fluent - .gitignore

# ── Python ──
__pycache__/
*.pyc
*.pyo

# ── 日志 ──
logs/
*.log

# ── 备份 ──
backups/

# ── 临时文件 ──
_update_*.zip
bds_manager_v*.zip
*.bak_
*.tmp
*_cleanup.bat
*_clean_archives.ps1
archives.rar

# ── IDE ──
.vscode/
.idea/

# ── OS ──
.DS_Store
Thumbs.db

# ── 本地开发工具（不应推送到仓库）──
release.py
archive.py

# ── 运行时生成的文件 ──
bds_manager_config.json
bds_manager_notifications.json
bds_version_cache.json
.upgrade_history.json
dist/
archives/
.workbuddy/
Server/

PROJECT_SUMMARY.md
