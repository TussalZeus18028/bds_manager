# BDS Manager Fluent - .gitignore

# ── Python ──
__pycache__/
*.pyc
*.pyo

# ── 日志 ──
logs/
*.log

# ── 备份 ──
backups/pre_refactor_*
backups/upgrade_backup_*

# ── 临时文件 ──
_update_*.zip
bds_manager_v*.zip
*.bak_
*.tmp
*_cleanup.bat
*_clean_archives.ps1

# ── IDE ──
.vscode/
.idea/

# ── OS ──
.DS_Store
Thumbs.db

# ── 本地开发工具（不应推送到仓库）──
release.py
archive.py

# ── 运行时生成的文件 ──
bds_manager_config.json       # 用户配置
bds_manager_notifications.json # 通知中心数据
bds_version_cache.json        # 升级页缓存
dist/                         # release.py 产出
archives/                     # archive.py 产出
.workbuddy/                   # WorkBuddy 会话数据

PROJECT_SUMMARY.md
